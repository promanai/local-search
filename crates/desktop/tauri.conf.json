{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalSearch",
  "version": "0.1.0",
  "identifier": "com.localsearch.desktop",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LocalSearch",
        "width": 760,
        "height": 540,
        "minWidth": 560,
        "minHeight": 360,
        "visible": false,
        "center": true,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
